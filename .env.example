# Appwrite contact form (permission-based, no API key needed)
# Create a project, database, and collection in Appwrite first.
# The collection's attributes must be: name, service, budget, message, source (all strings).
# Permissions must allow "any" (or "guests") to create documents.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://YOUR_REGION.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=your_project_id
NEXT_PUBLIC_APPWRITE_DATABASE_ID=your_database_id
NEXT_PUBLIC_APPWRITE_COLLECTION_ID=your_collection_id